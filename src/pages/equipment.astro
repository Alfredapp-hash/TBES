---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import EquipmentBrowser from "../components/EquipmentBrowser";
---

<Base
  title="Equipment"
  description="Sample used turbine and generator configurations. These examples are not a live offer."
>
  <PageHero
    eyebrow="Equipment"
    title="Sample used machines, not a live yard."
    lede="These examples show how a used unit will be described: type, condition, application, and output. Nothing here is an offer of a specific machine."
  />
  <section class="section">
    <div class="section-inner">
      <EquipmentBrowser client:load />
    </div>
  </section>
</Base>
