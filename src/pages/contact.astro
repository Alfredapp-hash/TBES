---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { leaders, mailing } from "../data/site";
---

<Base
  title="Contact"
  description="Buy a turbine, sell one, or ask to join the TBES contractor network."
>
  <PageHero
    eyebrow="Contact"
    title="Buy, sell, or join the network."
    lede="Say which one you are. Name the machine, or the classes you bid. Add timing only if you want us to have it."
  />

  <section class="section">
    <div class="section-inner split">
      <InquiryForm formName="contact" submitLabel="Send inquiry" />
      <aside class="stack">
        <article class="card">
          <h2>Mailing address</h2>
          <p>
            TurbineBridge Energy Solutions LLC (TBES)<br />
            {mailing.line1}<br />
            {mailing.line2}<br />
            {mailing.line3}
          </p>
        </article>
        {leaders.map((person) => (
          <article class="card">
            <p class="eyebrow">{person.role}</p>
            {"detail" in person && person.detail ? <p class="role-detail">{person.detail}</p> : null}
            <h3>{person.name}</h3>
            {person.phone ? (
              <p><a class="link" href={`tel:${person.tel}`}>{person.phone}</a></p>
            ) : (
              <p><a class="link" href={`#inquiry`}>Use the form</a></p>
            )}
          </article>
        ))}
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <article class="card">
        <h2>What happens next</h2>
        <p>
          We read the note and answer with the right next step. That step may be a question, a check on equipment, or a narrower scope for the work.
        </p>
        <p>
          Documents and status for an active engagement belong in the <a class="link" href="/portal">client portal</a> once that room is open. What this form collects is described on the <a class="link" href="/privacy">privacy page</a>.
        </p>
      </article>
    </div>
  </section>
</Base>
