---
import Base from "../layouts/Base.astro";
import { listings } from "../data/inventory";
import { leaders } from "../data/site";

const featuredIds = ["TB-S01", "TB-S05", "TB-S03"];
const featured = featuredIds.flatMap((id) => {
  const item = listings.find((listing) => listing.id === id);
  return item ? [item] : [];
});

const solutions = [
  {
    title: "Find the turbine",
    text: "A used unit of any class, in the condition it is in, if specialists can bring it back online.",
  },
  {
    title: "Check the machine",
    text: "Condition and records, before anyone treats a rough unit as a runner.",
  },
  {
    title: "Connect the specialists",
    text: "The right people for each part of the repair, including the control unit that starts, fuels, and protects the turbine.",
  },
  {
    title: "Put it online",
    text: "The shops do that work. We stay in the middle until the unit can run.",
  },
];

const markets = [
  { title: "Data centers", text: "Firm power when the hall is ready before the grid, including when a new large frame is years out." },
  { title: "Industrial", text: "A used unit for a plant that stops when the power stops. Any class that can be brought back online." },
  { title: "Utilities", text: "Capacity found as a used machine, then matched to the shops that can return it to service." },
  { title: "Mission-critical", text: "Loads where the date power is online matters more than a place in a new-unit queue." },
];

const values = [
  ["Integrity", "The condition is stated as found, including what the record does not show."],
  ["Reliability", "The introduction still holds after the first call."],
  ["Technical excellence", "The iron and the control unit each get a specialist who actually works that class."],
  ["Customer focus", "The load, the site, and the date set the search."],
  ["Sustainability", "A unit returned to service is preferred when it can do the duty."],
  ["Long-term partnerships", "We stay in the middle until the unit can go online, and after that if you want us there."],
];
---

<Base
  title="TurbineBridge Energy Solutions · Bridging power to possibilities"
  description="TurbineBridge finds used turbines of all kinds. Some new systems are five years out. We connect you with the specialists who bring a used unit back online."
>
  <section class="hero-stage" aria-label="TurbineBridge">
    <img
      class="hero-plate"
      src="/hero.jpg"
      width="1280"
      height="720"
      alt="Industrial gas turbine at sunrise beside a row of blue-lit data center racks"
    />
    <canvas class="energy-bridge" data-energy-bridge aria-hidden="true"></canvas>
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <h1>
        <span class="wordmark">Turbine<em>Bridge</em></span>
        <span class="legal">Energy Solutions LLC</span>
        <span class="tagline">Bridging power to possibilities</span>
      </h1>
      <p class="lede">If you need a turbine, we find a used unit of any class that can be brought back online, and we connect you with the specialists who put it in shape to run. Some new systems are five years out. You do not have to wait on that queue.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/solutions">Our solutions</a>
        <a class="btn btn-ghost" href="/contact">Contact us</a>
      </div>
    </div>
  </section>

  <section class="band" aria-label="How an engagement moves">
    <ol class="band-list">
      <li>
        <span>01</span>
        <strong>Find the turbine</strong>
        <em>A used machine, if it can be brought back online.</em>
      </li>
      <li>
        <span>02</span>
        <strong>Name the specialists</strong>
        <em>Every part of the repair, including the control unit.</em>
      </li>
      <li>
        <span>03</span>
        <strong>They do the work</strong>
        <em>The shops bring it back. We make the introduction.</em>
      </li>
      <li>
        <span>04</span>
        <strong>Put it online</strong>
        <em>Some new systems are five years out. A used unit does not have to wait.</em>
      </li>
    </ol>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="block-title">
        <p class="eyebrow">Start here</p>
        <h2>Two ways in.</h2>
      </div>
      <div class="grid-2">
        <a class="door card" href={`/contact?interest=${encodeURIComponent("I need a turbine")}`}>
          <p class="eyebrow">Need power</p>
          <h3>Find a turbine</h3>
          <p>Tell us the load and the timing. Any class. We find a used unit that specialists can bring back online, then make the introduction.</p>
          <span class="link">Start an inquiry</span>
        </a>
        <a class="door card" href={`/contact?interest=${encodeURIComponent("I repair turbines or control units")}`}>
          <p class="eyebrow">You do the work</p>
          <h3>You do the repair</h3>
          <p>If your shop repairs gas turbines, or the control units that run them, tell us the classes you handle. We connect you with the customer who has the machine.</p>
          <span class="link">Join the network</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="block-title">
        <p class="eyebrow">The desk</p>
        <h2>Who you reach.</h2>
      </div>
      <div class="grid-3">
        {leaders.map((person) => (
          <article class="card">
            <p class="eyebrow">{person.role}</p>
            {"detail" in person && person.detail ? <p class="role-detail">{person.detail}</p> : null}
            <h3>{person.name}</h3>
            {person.phone ? (
              <p><a class="link" href={`tel:${person.tel}`}>{person.phone}</a></p>
            ) : (
              <p><a class="link" href={`/contact?interest=${encodeURIComponent("Something else")}&who=${encodeURIComponent(person.name)}`}>Write {person.name.split(" ")[0]}</a></p>
            )}
          </article>
        ))}
      </div>
      <p class="more"><a class="link" href="/contact">Write the desk</a></p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner split">
      <div class="stack">
        <p class="eyebrow">Executive summary</p>
        <h2>We find the turbine. Then we connect the specialists.</h2>
        <p class="measure">
          That is the whole job. You need a turbine. We find a used one, any class, in whatever condition it is in, as long as specialists can bring it back online. Then we introduce the people who do that work.
        </p>
        <p class="measure">
          Those people cover the repair, including the control unit that starts, fuels, and protects the machine. The connections go back three decades in the power industry. The shops do the work. We are not the shop, and we are not the engineer of record.
        </p>
        <p class="measure">
          Some new turbine systems are five years out. That is true of certain large frames, and it is not true of every unit. We take all kinds: the machines stuck in that wait, and the smaller and mid-size units that are not. If specialists can bring it back online, we can find it.
        </p>
        <p><a class="link" href="/about">Read the company story</a></p>
      </div>
      <div class="stack">
        <article class="card">
          <h3>Mission</h3>
          <p>Find a used turbine the load can use, in any class, and introduce the specialists who can bring it online.</p>
        </article>
        <article class="card">
          <h3>Vision</h3>
          <p>Be the desk people call when a new system is years out, and when any used unit needs the right shop.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="block-title">
        <p class="eyebrow">Solutions</p>
        <h2>From a used machine to one that can run.</h2>
        <p class="measure">We find the turbine. The specialists put it in shape to go online. We stay in the middle of that path.</p>
      </div>
      <div class="grid-4">
        {solutions.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="more"><a class="link" href="/solutions">See how an engagement moves</a></p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="block-title">
        <p class="eyebrow">Markets</p>
        <h2>Where the power has to show up.</h2>
      </div>
      <div class="grid-4">
        {markets.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="more"><a class="link" href="/markets">Markets in detail</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="block-title">
        <p class="eyebrow">Equipment</p>
        <h2>Sample configurations.</h2>
        <p class="measure">These cards show how a used machine will be described. They are not units currently offered. Availability is confirmed only after an inquiry.</p>
      </div>
      <div class="grid-3">
        {featured.map((item) => (
          <article class="listing-card">
            <p class="listing-id">{item.id}</p>
            <p class="listing-flag">Sample listing</p>
            <h3>{item.name}</h3>
            <p class="spec-row">{item.outputLabel} · {item.condition} · {item.type}</p>
            <p>{item.summary}</p>
            <a class="link" href={`/contact?interest=${encodeURIComponent("I need a turbine")}&listing=${item.id}`}>Ask about this configuration</a>
          </article>
        ))}
      </div>
      <p class="more"><a class="link" href="/equipment">Filter the sample catalog</a></p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="block-title">
        <p class="eyebrow">Core values</p>
        <h2>How the work is judged.</h2>
      </div>
      <div class="grid-3">
        {values.map(([title, text]) => (
          <article class="card">
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-inner">
      <p class="eyebrow on-dark">Start a conversation</p>
      <h2>Need a turbine, or do you repair them?</h2>
      <p>If you need power, tell us the load. If you hold a used machine, or you are the specialist who can bring one back online, say so. Same desk either way.</p>
      <a class="btn btn-primary" href="/contact">Contact us</a>
    </div>
  </section>
</Base>

<script>
  import "../scripts/energy-bridge.ts";
</script>
