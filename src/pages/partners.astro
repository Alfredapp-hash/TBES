---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { reach } from "../data/site";
---

<Base
  title="Partner with us"
  description="Buy a turbine, sell one, or join the contractor network TBES recommends to bid the work."
>
  <PageHero
    eyebrow="Partners"
    title="Buyers, sellers, and contractors."
    lede="TBES sits in the middle. We find the turbine. When a customer needs work done, we recommend contractors from our network to bid it."
  />

  <section class="section">
    <div class="section-inner stack">
      <div class="grid-3">
        {reach.map((item) => (
          <a class="door card" href={`/contact?interest=${encodeURIComponent(item.interest)}`}>
            <p class="eyebrow">{item.eyebrow}</p>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
            <span class="link">{item.cta}</span>
          </a>
        ))}
      </div>
      <p class="measure" id="participation-caution">
        Nothing on this site is an offer to sell a security. Any participation structure is discussed directly with the company.
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner stack">
      <p>
        The links above open the desk with your reason already chosen. You can also <a class="link" href="#partner-inquiry">write it here</a>.
      </p>
      <div id="partner-inquiry">
        <InquiryForm
          formName="partner"
          defaultInterest="I want to sell a turbine"
          submitLabel="Send partnership note"
        />
      </div>
    </div>
  </section>
</Base>
