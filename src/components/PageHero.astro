---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  <div class="section-inner">
    <div class="bridge-line" aria-hidden="true"></div>
    <p class="eyebrow on-dark">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
  </div>
</section>
